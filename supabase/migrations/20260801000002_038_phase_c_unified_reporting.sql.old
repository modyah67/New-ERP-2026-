-- ============================================================================
-- 038_phase_c_unified_reporting.sql
--
-- Migrates the entire reporting layer from legacy `transactions` table
-- to the unified accounting engine (journal_entries + account_ledger_entries).
--
-- Creates:
--   1. get_account_totals_rpc_v2  — Trial Balance / Balance Sheet / Income Statement
--   2. get_account_total_by_id_rpc_v2 — Single-account totals
--   3. get_balance_before_date_rpc_v2 — Opening balance
--   4. get_ledger_page_rpc_v2 — General Ledger with cursor pagination
--   5. validate_trial_balance_rpc — Server-side TB validation
--   6. validate_balance_sheet_rpc — Server-side BS validation
-- ============================================================================

BEGIN;

-- ============================================================================
-- 1. get_account_totals_rpc_v2
--    Aggregate debit/credit per account from account_ledger_entries + journal_entries
--    Drop old version first (return type changes can cause issues)
-- ============================================================================

DROP FUNCTION IF EXISTS get_account_totals_rpc(DATE, DATE);

CREATE OR REPLACE FUNCTION get_account_totals_rpc(
  p_from DATE DEFAULT NULL,
  p_to DATE DEFAULT NULL
)
RETURNS TABLE(account_id TEXT, debit NUMERIC, credit NUMERIC)
LANGUAGE sql STABLE
SECURITY DEFINER
SET search_path = public, extensions
AS $$
  SELECT
    ale.account_id::text AS account_id,
    COALESCE(SUM(ale.debit), 0)::numeric AS debit,
    COALESCE(SUM(ale.credit), 0)::numeric AS credit
  FROM account_ledger_entries ale
  INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
  WHERE je.deleted_at IS NULL
    AND ale.deleted_at IS NULL
    AND (p_from IS NULL OR je.entry_date >= p_from)
    AND (p_to IS NULL OR je.entry_date <= p_to)
  GROUP BY ale.account_id;
$$;

-- ============================================================================
-- 2. get_account_total_by_id_rpc_v2
--    Single-account totals from unified engine
-- ============================================================================

DROP FUNCTION IF EXISTS get_account_total_by_id_rpc(TEXT, DATE, DATE);

CREATE OR REPLACE FUNCTION get_account_total_by_id_rpc(
  p_account_id TEXT,
  p_from DATE DEFAULT NULL,
  p_to DATE DEFAULT NULL
)
RETURNS TABLE(debit NUMERIC, credit NUMERIC)
LANGUAGE sql STABLE
SECURITY DEFINER
SET search_path = public, extensions
AS $$
  SELECT
    COALESCE(SUM(ale.debit), 0)::numeric AS debit,
    COALESCE(SUM(ale.credit), 0)::numeric AS credit
  FROM account_ledger_entries ale
  INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
  WHERE ale.account_id::text = p_account_id
    AND je.deleted_at IS NULL
    AND ale.deleted_at IS NULL
    AND (p_from IS NULL OR je.entry_date >= p_from)
    AND (p_to IS NULL OR je.entry_date <= p_to);
$$;

-- ============================================================================
-- 3. get_balance_before_date_rpc_v2
--    Opening balance (debit/credit sums) for an account before a date
-- ============================================================================

DROP FUNCTION IF EXISTS get_balance_before_date_rpc(TEXT, DATE);

CREATE OR REPLACE FUNCTION get_balance_before_date_rpc(
  p_account_id TEXT,
  p_before_date DATE
)
RETURNS TABLE(debit NUMERIC, credit NUMERIC)
LANGUAGE sql STABLE
SECURITY DEFINER
SET search_path = public, extensions
AS $$
  SELECT
    COALESCE(SUM(ale.debit), 0)::numeric AS debit,
    COALESCE(SUM(ale.credit), 0)::numeric AS credit
  FROM account_ledger_entries ale
  INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
  WHERE ale.account_id::text = p_account_id
    AND je.deleted_at IS NULL
    AND ale.deleted_at IS NULL
    AND je.entry_date < p_before_date;
$$;

-- ============================================================================
-- 4. get_ledger_page_rpc_v2
--    General Ledger with cursor-based pagination + opening balance
--    Reads from account_ledger_entries + journal_entries + accounts
-- ============================================================================

DROP FUNCTION IF EXISTS get_ledger_page_rpc(TEXT, TEXT, TEXT, TEXT, TEXT, INTEGER);

CREATE OR REPLACE FUNCTION get_ledger_page_rpc(
  p_account_id TEXT DEFAULT NULL,
  p_from_date TEXT DEFAULT NULL,
  p_to_date TEXT DEFAULT NULL,
  p_cursor_date TEXT DEFAULT NULL,
  p_cursor_id TEXT DEFAULT NULL,
  p_limit INTEGER DEFAULT 50
)
RETURNS TABLE(
  id TEXT,
  date TEXT,
  entry_number TEXT,
  account_id TEXT,
  account_code TEXT,
  account_name TEXT,
  description TEXT,
  debit NUMERIC,
  credit NUMERIC,
  reference_type TEXT,
  reference_id TEXT,
  next_cursor_date TEXT,
  next_cursor_id TEXT,
  has_more BOOLEAN,
  opening_balance_debit NUMERIC,
  opening_balance_credit NUMERIC
)
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public, extensions
AS $$
DECLARE
  v_cursor_ts TIMESTAMPTZ;
  v_ob_debit NUMERIC := 0;
  v_ob_credit NUMERIC := 0;
  v_cursor_entry_id BIGINT;
BEGIN
  -- Parse cursor
  IF p_cursor_date IS NOT NULL AND p_cursor_id IS NOT NULL THEN
    v_cursor_ts := p_cursor_date::TIMESTAMPTZ;
    v_cursor_entry_id := p_cursor_id::BIGINT;
  END IF;

  -- Compute opening balance
  IF v_cursor_ts IS NOT NULL THEN
    -- Paginated page: opening balance before cursor timestamp
    SELECT
      COALESCE(SUM(ale.debit), 0),
      COALESCE(SUM(ale.credit), 0)
    INTO v_ob_debit, v_ob_credit
    FROM account_ledger_entries ale
    INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
    WHERE (p_account_id IS NULL OR ale.account_id::text = p_account_id)
      AND je.deleted_at IS NULL
      AND ale.deleted_at IS NULL
      AND je.entry_date < (v_cursor_ts AT TIME ZONE 'UTC');
  ELSE
    -- First page: opening balance before fromDate
    IF p_from_date IS NOT NULL THEN
      SELECT
        COALESCE(SUM(ale.debit), 0),
        COALESCE(SUM(ale.credit), 0)
      INTO v_ob_debit, v_ob_credit
      FROM account_ledger_entries ale
      INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
      WHERE (p_account_id IS NULL OR ale.account_id::text = p_account_id)
        AND je.deleted_at IS NULL
        AND ale.deleted_at IS NULL
        AND je.entry_date < p_from_date::DATE;
    END IF;
  END IF;

  RETURN QUERY
  WITH page AS (
    SELECT
      ale.id::TEXT AS p_id,
      je.entry_date::TEXT AS p_date,
      COALESCE(je.entry_number, '')::TEXT AS p_entry_number,
      ale.account_id::TEXT AS p_account_id,
      COALESCE(a.account_code, '')::TEXT AS p_account_code,
      COALESCE(a.account_name, '')::TEXT AS p_account_name,
      CASE
        WHEN je.source_type = 'opening_balance' THEN
          CASE
            WHEN a.account_code LIKE '111%' THEN 'قيد الرصيد الافتتاحي للخزينة الرئيسية'
            WHEN a.account_code LIKE '112%' THEN 'قيد الرصيد الافتتاحي للحساب البنكي'
            ELSE COALESCE(ale.description, je.description, '')
          END
        ELSE COALESCE(ale.description, je.description, '')
      END::TEXT AS p_description,
      COALESCE(ale.debit, 0) AS p_debit,
      COALESCE(ale.credit, 0) AS p_credit,
      COALESCE(je.source_type, '')::TEXT AS p_reference_type,
      COALESCE(je.source_id, '')::TEXT AS p_reference_id
    FROM account_ledger_entries ale
    INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
    LEFT JOIN accounts a ON a.id = ale.account_id
    WHERE je.deleted_at IS NULL
      AND ale.deleted_at IS NULL
      AND (p_account_id IS NULL OR ale.account_id::text = p_account_id)
      AND (p_from_date IS NULL OR je.entry_date >= p_from_date::DATE)
      AND (p_to_date IS NULL OR je.entry_date <= p_to_date::DATE)
      AND (
        v_cursor_ts IS NULL
        OR je.entry_date > (v_cursor_ts AT TIME ZONE 'UTC')
        OR (je.entry_date = (v_cursor_ts AT TIME ZONE 'UTC')
            AND ale.id > v_cursor_entry_id)
      )
    ORDER BY je.entry_date ASC, ale.id ASC
    LIMIT (p_limit + 1)
  ),
  page_data AS (
    SELECT * FROM page LIMIT p_limit
  ),
  has_more_check AS (
    SELECT COUNT(*) > 0 AS has_more FROM page WHERE NOT EXISTS (SELECT 1 FROM page_data)
  )
  SELECT
    pd.p_id,
    pd.p_date,
    pd.p_entry_number,
    pd.p_account_id,
    pd.p_account_code,
    pd.p_account_name,
    pd.p_description,
    pd.p_debit,
    pd.p_credit,
    pd.p_reference_type,
    pd.p_reference_id,
    (SELECT p2.p_date FROM page p2 ORDER BY p2.p_date DESC, p2.p_id DESC LIMIT 1)::TEXT,
    (SELECT p2.p_id FROM page p2 ORDER BY p2.p_date DESC, p2.p_id DESC LIMIT 1)::TEXT,
    hmc.has_more,
    v_ob_debit,
    v_ob_credit
  FROM page_data pd
  CROSS JOIN has_more_check hmc;
END;
$$;

-- ============================================================================
-- 5. validate_trial_balance_rpc
--    Server-side validation: verify total debits == total credits
-- ============================================================================

CREATE OR REPLACE FUNCTION validate_trial_balance_rpc(
  p_from DATE DEFAULT NULL,
  p_to DATE DEFAULT NULL
)
RETURNS TABLE(
  total_debit NUMERIC,
  total_credit NUMERIC,
  is_balanced BOOLEAN,
  difference NUMERIC
)
LANGUAGE sql STABLE
SECURITY DEFINER
SET search_path = public, extensions
AS $$
  WITH totals AS (
    SELECT
      COALESCE(SUM(ale.debit), 0)::numeric AS total_debit,
      COALESCE(SUM(ale.credit), 0)::numeric AS total_credit
    FROM account_ledger_entries ale
    INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
    WHERE je.deleted_at IS NULL
      AND ale.deleted_at IS NULL
      AND (p_from IS NULL OR je.entry_date >= p_from)
      AND (p_to IS NULL OR je.entry_date <= p_to)
  )
  SELECT
    t.total_debit,
    t.total_credit,
    ABS(t.total_debit - t.total_credit) < 0.01 AS is_balanced,
    t.total_debit - t.total_credit AS difference
  FROM totals t;
$$;

-- ============================================================================
-- 6. validate_balance_sheet_rpc
--    Server-side validation: Assets == Liabilities + Equity
-- ============================================================================

CREATE OR REPLACE FUNCTION validate_balance_sheet_rpc(
  p_as_of_date DATE DEFAULT NULL
)
RETURNS TABLE(
  total_assets NUMERIC,
  total_liabilities NUMERIC,
  total_equity NUMERIC,
  total_liabilities_and_equity NUMERIC,
  is_balanced BOOLEAN,
  difference NUMERIC
)
LANGUAGE sql STABLE
SECURITY DEFINER
SET search_path = public, extensions
AS $$
  WITH account_balances AS (
    SELECT
      ale.account_id,
      COALESCE(SUM(ale.debit), 0) AS total_debit,
      COALESCE(SUM(ale.credit), 0) AS total_credit
    FROM account_ledger_entries ale
    INNER JOIN journal_entries je ON je.id = ale.journal_entry_id
    WHERE je.deleted_at IS NULL
      AND ale.deleted_at IS NULL
      AND (p_as_of_date IS NULL OR je.entry_date <= p_as_of_date)
    GROUP BY ale.account_id
  ),
  classified AS (
    SELECT
      ab.total_debit,
      ab.total_credit,
      CASE
        WHEN a.account_type = 'asset' THEN 'asset'
        WHEN a.account_type = 'liability' THEN 'liability'
        WHEN a.account_type = 'equity' THEN 'equity'
        ELSE 'other'
      END AS classification,
      -- Net balance: debit-normal (asset) = debit - credit; credit-normal = credit - debit
      CASE
        WHEN a.account_type = 'asset' THEN ab.total_debit - ab.total_credit
        ELSE ab.total_credit - ab.total_debit
      END AS net_balance
    FROM account_balances ab
    INNER JOIN accounts a ON a.id = ab.account_id
    WHERE a.account_type IN ('asset', 'liability', 'equity')
  ),
  summed AS (
    SELECT
      COALESCE(SUM(CASE WHEN classification = 'asset' THEN net_balance ELSE 0 END), 0) AS total_assets,
      COALESCE(SUM(CASE WHEN classification = 'liability' THEN net_balance ELSE 0 END), 0) AS total_liabilities,
      COALESCE(SUM(CASE WHEN classification = 'equity' THEN net_balance ELSE 0 END), 0) AS total_equity
    FROM classified
  )
  SELECT
    s.total_assets,
    s.total_liabilities,
    s.total_equity,
    (s.total_liabilities + s.total_equity) AS total_liabilities_and_equity,
    ABS(s.total_assets - (s.total_liabilities + s.total_equity)) < 0.01 AS is_balanced,
    s.total_assets - (s.total_liabilities + s.total_equity) AS difference
  FROM summed s;
$$;

-- ============================================================================
-- GRANT permissions on all new/updated functions
-- ============================================================================

GRANT EXECUTE ON FUNCTION get_account_totals_rpc(DATE, DATE) TO authenticated;
GRANT EXECUTE ON FUNCTION get_account_total_by_id_rpc(TEXT, DATE, DATE) TO authenticated;
GRANT EXECUTE ON FUNCTION get_balance_before_date_rpc(TEXT, DATE) TO authenticated;
GRANT EXECUTE ON FUNCTION get_ledger_page_rpc(TEXT, TEXT, TEXT, TEXT, TEXT, INTEGER) TO authenticated;
GRANT EXECUTE ON FUNCTION validate_trial_balance_rpc(DATE, DATE) TO authenticated;
GRANT EXECUTE ON FUNCTION validate_balance_sheet_rpc(DATE) TO authenticated;

GRANT EXECUTE ON FUNCTION get_account_totals_rpc(DATE, DATE) TO service_role;
GRANT EXECUTE ON FUNCTION get_account_total_by_id_rpc(TEXT, DATE, DATE) TO service_role;
GRANT EXECUTE ON FUNCTION get_balance_before_date_rpc(TEXT, DATE) TO service_role;
GRANT EXECUTE ON FUNCTION get_ledger_page_rpc(TEXT, TEXT, TEXT, TEXT, TEXT, INTEGER) TO service_role;
GRANT EXECUTE ON FUNCTION validate_trial_balance_rpc(DATE, DATE) TO service_role;
GRANT EXECUTE ON FUNCTION validate_balance_sheet_rpc(DATE) TO service_role;

COMMIT;
