-- Migration 076: Add expense_account_id to cheques table and fix GL integration
--
-- PROBLEM:
-- When clearing outgoing cheques, the system throws error:
-- "يجب اختيار حساب مصروفات من شجرة الحسابات — لا يسمح بالقيود الافتراضية"
--
-- ROOT CAUSE:
-- 1. cheques table lacks expense_account_id column
-- 2. counterparty_type CHECK constraint only allows 'customer' and 'supplier'
-- 3. clear_cheque() doesn't handle 'expense' or 'account' types
-- 4. UI doesn't allow selecting expense accounts for expense-type cheques
--
-- FIX:
-- 1. Add expense_account_id column to cheques table
-- 2. Expand counterparty_type CHECK constraint to include all types
-- 3. Update clear_cheque() to resolve GL accounts correctly for each type
-- 4. Add debug logging before journal entry creation

BEGIN;

-- ============================================================
-- 1. Add expense_account_id column to cheques table
-- ============================================================
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns
    WHERE table_name = 'cheques' AND column_name = 'expense_account_id'
  ) THEN
    ALTER TABLE public.cheques
      ADD COLUMN expense_account_id BIGINT REFERENCES public.chart_of_accounts(id) ON DELETE SET NULL;
  END IF;
END $$;

-- ============================================================
-- 2. Expand counterparty_type CHECK constraint
-- ============================================================
-- First, drop the existing constraint
ALTER TABLE public.cheques
  DROP CONSTRAINT IF EXISTS cheques_counterparty_type_check;

-- Add expanded constraint
ALTER TABLE public.cheques
  ADD CONSTRAINT cheques_counterparty_type_check
  CHECK (counterparty_type IN ('customer', 'supplier', 'shareholder', 'clearing_agent', 'shipping_company', 'expense', 'account', 'treasury', NULL));

-- ============================================================
-- 3. Update clear_cheque with proper GL account resolution and debug logging
-- ============================================================
DROP FUNCTION IF EXISTS public.clear_cheque(BIGINT);

CREATE OR REPLACE FUNCTION public.clear_cheque(p_cheque_id BIGINT)
RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
    v_cheque RECORD;
    v_desc TEXT;
    v_bank_id INTEGER;
    v_bank_bal NUMERIC;
    v_currency TEXT;
    v_company_id UUID;
    v_new_bank_bal NUMERIC;
    v_bank_acct BIGINT;
    v_counterparty_acct BIGINT;
    v_je_id BIGINT;
    v_bank_tx_id BIGINT;
    v_employee_acct BIGINT;
BEGIN
    SELECT * INTO v_cheque
    FROM public.cheques
    WHERE id = p_cheque_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'الشيك غير موجود';
    END IF;

    IF v_cheque.status != 'pending' THEN
        RAISE EXCEPTION 'لا يمكن تسوية شيك بحالة %', v_cheque.status;
    END IF;

    IF v_cheque.type = 'outgoing' THEN
        v_desc := 'صرف شيك رقم: ' || v_cheque.cheque_number;
    ELSE
        v_desc := 'تحصيل شيك رقم: ' || v_cheque.cheque_number;
    END IF;

    -- Get bank account for this currency
    SELECT id, balance, ba.company_id INTO v_bank_id, v_bank_bal, v_company_id
    FROM public.bank_accounts ba
    WHERE ba.currency = v_cheque.currency
    LIMIT 1
    FOR UPDATE;

    IF v_bank_id IS NULL THEN
        RAISE EXCEPTION 'لا توجد حساب بنكي بهذه العملة';
    END IF;

    v_currency := v_cheque.currency;

    -- Resolve bank GL account by currency
    v_bank_acct := public.resolve_gl_account(
        CASE v_currency
            WHEN 'EGP' THEN '11201'
            WHEN 'USD' THEN '11202'
            WHEN 'EUR' THEN '11203'
            WHEN 'GBP' THEN '11204'
            ELSE '11201'
        END,
        v_company_id
    );

    -- ================================================================
    -- DEBUG LOGGING: Print all key information before journal entry
    -- ================================================================
    RAISE NOTICE '=== CLEAR CHEQUE DEBUG ===';
    RAISE NOTICE 'Cheque ID: %', v_cheque.id;
    RAISE NOTICE 'Cheque Type: %', v_cheque.type;
    RAISE NOTICE 'Beneficiary Type: %', COALESCE(v_cheque.counterparty_type, 'NULL');
    RAISE NOTICE 'Beneficiary ID: %', COALESCE(v_cheque.counterparty_id::TEXT, 'NULL');
    RAISE NOTICE 'Supplier ID: %', COALESCE(v_cheque.supplier_id::TEXT, 'NULL');
    RAISE NOTICE 'Shareholder ID: %', COALESCE(v_cheque.shareholder_id::TEXT, 'NULL');
    RAISE NOTICE 'Clearing Agent ID: %', COALESCE(v_cheque.clearing_agent_id::TEXT, 'NULL');
    RAISE NOTICE 'Shipping Company ID: %', COALESCE(v_cheque.shipping_company_id::TEXT, 'NULL');
    RAISE NOTICE 'Expense Account ID: %', COALESCE(v_cheque.expense_account_id::TEXT, 'NULL');
    RAISE NOTICE 'Bank GL Account: %', v_bank_acct;
    RAISE NOTICE 'Currency: %', v_currency;
    RAISE NOTICE 'Amount: %', v_cheque.amount;
    RAISE NOTICE '========================';

    -- ================================================================
    -- OUTGOING CHEQUE: Dr Counterparty / Cr Bank
    -- ================================================================
    IF v_cheque.type = 'outgoing' THEN
        IF v_bank_bal < v_cheque.amount THEN
            RAISE EXCEPTION 'الرصيد غير كافٍ في الحساب البنكي (% متوفر)', v_bank_bal;
        END IF;

        v_new_bank_bal := v_bank_bal - v_cheque.amount;

        -- Determine debit account (counterparty) based on beneficiary type
        v_counterparty_acct := NULL;

        IF v_cheque.counterparty_type = 'customer' AND v_cheque.counterparty_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.customers WHERE id = v_cheque.counterparty_id;
            UPDATE public.customers SET balance = balance + v_cheque.amount
            WHERE id = v_cheque.counterparty_id;

        ELSIF v_cheque.counterparty_type = 'supplier' AND v_cheque.supplier_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.suppliers WHERE id = v_cheque.supplier_id;
            UPDATE public.suppliers SET outstanding_balance = outstanding_balance - v_cheque.amount
            WHERE id = v_cheque.supplier_id;

        ELSIF v_cheque.counterparty_type = 'clearing_agent' AND v_cheque.clearing_agent_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.clearing_agents WHERE id = v_cheque.clearing_agent_id;
            UPDATE public.clearing_agents SET balance = balance - v_cheque.amount
            WHERE id = v_cheque.clearing_agent_id;

        ELSIF v_cheque.counterparty_type = 'shipping_company' AND v_cheque.shipping_company_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.shipping_companies WHERE id = v_cheque.shipping_company_id;
            UPDATE public.shipping_companies SET balance = balance - v_cheque.amount
            WHERE id = v_cheque.shipping_company_id;

        ELSIF v_cheque.counterparty_type = 'shareholder' AND v_cheque.shareholder_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.shareholders WHERE id = v_cheque.shareholder_id;
            IF v_currency = 'EGP' THEN UPDATE public.shareholders SET current_balance_egp = current_balance_egp - v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'USD' THEN UPDATE public.shareholders SET current_balance_usd = current_balance_usd - v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'EUR' THEN UPDATE public.shareholders SET current_balance_eur = current_balance_eur - v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'GBP' THEN UPDATE public.shareholders SET current_balance_gbp = current_balance_gbp - v_cheque.amount WHERE id = v_cheque.shareholder_id;
            END IF;

        ELSIF v_cheque.counterparty_type = 'expense' AND v_cheque.expense_account_id IS NOT NULL THEN
            -- Use the explicitly selected expense account
            v_counterparty_acct := v_cheque.expense_account_id;

        ELSIF v_cheque.counterparty_type = 'account' AND v_cheque.expense_account_id IS NOT NULL THEN
            -- Use the selected account from chart of accounts
            v_counterparty_acct := v_cheque.expense_account_id;

        ELSIF v_cheque.counterparty_type = 'treasury' THEN
            -- Use treasury equity account
            v_counterparty_acct := public.resolve_equity_account(v_currency, v_company_id);

        END IF;

        -- Final validation: must have a valid GL account
        IF v_counterparty_acct IS NULL THEN
            RAISE EXCEPTION 'لم يتم العثور على حساب محاسبي لنوع المستفيد: %. يرجى اختيار حساب مصروفات صحيح.', COALESCE(v_cheque.counterparty_type, 'غير محدد');
        END IF;

        RAISE NOTICE 'Resolved GL Account for counterparty: %', v_counterparty_acct;

        -- Post journal entry: Dr Counterparty / Cr Bank
        v_je_id := public.post_journal_entry(
            'bank_withdraw',
            v_desc,
            CURRENT_DATE,
            v_company_id,
            auth.uid(),
            jsonb_build_array(
                jsonb_build_object(
                    'account_id', v_counterparty_acct,
                    'debit', v_cheque.amount,
                    'credit', 0,
                    'currency', v_currency,
                    'description', v_desc
                ),
                jsonb_build_object(
                    'account_id', v_bank_acct,
                    'debit', 0,
                    'credit', v_cheque.amount,
                    'currency', v_currency,
                    'description', v_desc
                )
            )
        );

        RAISE NOTICE 'Journal Entry created with ID: %', v_je_id;

        -- Update bank balance
        UPDATE public.bank_accounts
        SET balance = v_new_bank_bal, updated_at = now()
        WHERE id = v_bank_id;

        -- Record bank transaction WITH journal_entry_id
        INSERT INTO public.bank_account_transactions
            (bank_account_id, type, amount, balance_before, balance_after,
             description, created_by, journal_entry_id, entity_type, entity_id, source_type)
        VALUES
            (v_bank_id, 'withdrawal', v_cheque.amount, v_bank_bal, v_new_bank_bal,
             v_desc, auth.uid(), v_je_id, 'cheque', p_cheque_id::TEXT, 'cheque')
        RETURNING id INTO v_bank_tx_id;

    -- ================================================================
    -- INCOMING CHEQUE: Dr Bank / Cr Counterparty
    -- ================================================================
    ELSIF v_cheque.type = 'incoming' THEN
        v_new_bank_bal := v_bank_bal + v_cheque.amount;

        -- Determine credit account (counterparty)
        v_counterparty_acct := NULL;

        IF v_cheque.counterparty_type = 'customer' AND v_cheque.counterparty_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.customers WHERE id = v_cheque.counterparty_id;
            UPDATE public.customers SET balance = balance - v_cheque.amount
            WHERE id = v_cheque.counterparty_id;

        ELSIF v_cheque.counterparty_type = 'supplier' AND v_cheque.supplier_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.suppliers WHERE id = v_cheque.supplier_id;
            UPDATE public.suppliers SET outstanding_balance = outstanding_balance + v_cheque.amount
            WHERE id = v_cheque.supplier_id;

        ELSIF v_cheque.counterparty_type = 'clearing_agent' AND v_cheque.clearing_agent_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.clearing_agents WHERE id = v_cheque.clearing_agent_id;
            UPDATE public.clearing_agents SET balance = balance + v_cheque.amount
            WHERE id = v_cheque.clearing_agent_id;

        ELSIF v_cheque.counterparty_type = 'shipping_company' AND v_cheque.shipping_company_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.shipping_companies WHERE id = v_cheque.shipping_company_id;
            UPDATE public.shipping_companies SET balance = balance + v_cheque.amount
            WHERE id = v_cheque.shipping_company_id;

        ELSIF v_cheque.counterparty_type = 'shareholder' AND v_cheque.shareholder_id IS NOT NULL THEN
            SELECT account_id INTO v_counterparty_acct
            FROM public.shareholders WHERE id = v_cheque.shareholder_id;
            IF v_currency = 'EGP' THEN UPDATE public.shareholders SET current_balance_egp = current_balance_egp + v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'USD' THEN UPDATE public.shareholders SET current_balance_usd = current_balance_usd + v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'EUR' THEN UPDATE public.shareholders SET current_balance_eur = current_balance_eur + v_cheque.amount WHERE id = v_cheque.shareholder_id;
            ELSIF v_currency = 'GBP' THEN UPDATE public.shareholders SET current_balance_gbp = current_balance_gbp + v_cheque.amount WHERE id = v_cheque.shareholder_id;
            END IF;

        ELSIF v_cheque.counterparty_type = 'account' AND v_cheque.expense_account_id IS NOT NULL THEN
            -- Use the selected account from chart of accounts
            v_counterparty_acct := v_cheque.expense_account_id;

        ELSIF v_cheque.counterparty_type = 'treasury' THEN
            -- Use treasury equity account
            v_counterparty_acct := public.resolve_equity_account(v_currency, v_company_id);

        END IF;

        -- Final validation: must have a valid GL account
        IF v_counterparty_acct IS NULL THEN
            RAISE EXCEPTION 'لم يتم العثور على حساب محاسبي لنوع المرسل: %', COALESCE(v_cheque.counterparty_type, 'غير محدد');
        END IF;

        RAISE NOTICE 'Resolved GL Account for counterparty: %', v_counterparty_acct;

        -- Post journal entry: Dr Bank / Cr Counterparty
        v_je_id := public.post_journal_entry(
            'bank_deposit',
            v_desc,
            CURRENT_DATE,
            v_company_id,
            auth.uid(),
            jsonb_build_array(
                jsonb_build_object(
                    'account_id', v_bank_acct,
                    'debit', v_cheque.amount,
                    'credit', 0,
                    'currency', v_currency,
                    'description', v_desc
                ),
                jsonb_build_object(
                    'account_id', v_counterparty_acct,
                    'debit', 0,
                    'credit', v_cheque.amount,
                    'currency', v_currency,
                    'description', v_desc
                )
            )
        );

        RAISE NOTICE 'Journal Entry created with ID: %', v_je_id;

        -- Update bank balance
        UPDATE public.bank_accounts
        SET balance = v_new_bank_bal, updated_at = now()
        WHERE id = v_bank_id;

        -- Record bank transaction WITH journal_entry_id
        INSERT INTO public.bank_account_transactions
            (bank_account_id, type, amount, balance_before, balance_after,
             description, created_by, journal_entry_id, entity_type, entity_id, source_type)
        VALUES
            (v_bank_id, 'deposit', v_cheque.amount, v_bank_bal, v_new_bank_bal,
             v_desc, auth.uid(), v_je_id, 'cheque', p_cheque_id::TEXT, 'cheque')
        RETURNING id INTO v_bank_tx_id;

    END IF;

    -- Update cheque status + store journal_entry_id
    UPDATE public.cheques
    SET status = 'cleared',
        cleared_at = NOW(),
        journal_entry_id = v_je_id
    WHERE id = p_cheque_id;

    RAISE NOTICE 'Cheque cleared successfully. Journal Entry ID: %, Bank TX ID: %', v_je_id, v_bank_tx_id;

    RETURN jsonb_build_object(
        'success', true,
        'journal_entry_id', v_je_id,
        'bank_tx_id', v_bank_tx_id
    );
END;
$$;

GRANT EXECUTE ON FUNCTION public.clear_cheque(BIGINT) TO authenticated;

-- ============================================================
-- 4. Update create_cheque to accept expense_account_id
-- ============================================================
DROP FUNCTION IF EXISTS public.create_cheque(TEXT, TEXT, NUMERIC, TEXT, DATE, DATE, TEXT, BIGINT, TEXT, UUID, BIGINT, BIGINT, UUID, INTEGER);

CREATE OR REPLACE FUNCTION public.create_cheque(
    p_cheque_number         TEXT,
    p_type                  TEXT,
    p_amount                NUMERIC,
    p_currency              TEXT,
    p_issue_date            DATE,
    p_due_date              DATE,
    p_counterparty_type     TEXT DEFAULT NULL,
    p_counterparty_id       BIGINT DEFAULT NULL,
    p_notes                 TEXT DEFAULT NULL,
    p_supplier_id           UUID DEFAULT NULL,
    p_clearing_agent_id     BIGINT DEFAULT NULL,
    p_shipping_company_id   BIGINT DEFAULT NULL,
    p_shareholder_id        UUID DEFAULT NULL,
    p_category_id           INTEGER DEFAULT NULL,
    p_expense_account_id    BIGINT DEFAULT NULL
) RETURNS JSONB
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path TO 'public'
AS $$
DECLARE
    v_id BIGINT;
BEGIN
    IF p_amount <= 0 THEN
        RAISE EXCEPTION 'المبلغ يجب أن يكون أكبر من صفر';
    END IF;

    IF p_due_date < p_issue_date THEN
        RAISE EXCEPTION 'تاريخ الاستحقاق يجب أن يكون بعد تاريخ التحرير';
    END IF;

    INSERT INTO public.cheques (
        cheque_number, type, status, amount, currency,
        issue_date, due_date, counterparty_type, counterparty_id,
        supplier_id, clearing_agent_id, shipping_company_id, shareholder_id,
        notes, created_by, category_id, expense_account_id
    ) VALUES (
        p_cheque_number, p_type, 'pending', p_amount, p_currency,
        p_issue_date, p_due_date, p_counterparty_type, p_counterparty_id,
        p_supplier_id, p_clearing_agent_id, p_shipping_company_id, p_shareholder_id,
        p_notes, auth.uid(), p_category_id, p_expense_account_id
    ) RETURNING id INTO v_id;

    RETURN jsonb_build_object('id', v_id);
END;
$$;

GRANT EXECUTE ON FUNCTION public.create_cheque(
    TEXT, TEXT, NUMERIC, TEXT, DATE, DATE,
    TEXT, BIGINT, TEXT, UUID, BIGINT, BIGINT, UUID, INTEGER, BIGINT
) TO authenticated;

-- ============================================================
-- 5. Notify PostgREST to reload schema cache
-- ============================================================
NOTIFY pgrst, 'reload schema';

COMMIT;
