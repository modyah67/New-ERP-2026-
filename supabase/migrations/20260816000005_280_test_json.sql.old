CREATE OR REPLACE FUNCTION public.test_jsonb_parsing(p_packing_order_id bigint) RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE
  v_notes jsonb;
BEGIN
  SELECT notes INTO v_notes FROM packing_orders WHERE id = p_packing_order_id;
  
  -- Handle Dart encoding an object containing stringified JSON under 'notes'
  IF jsonb_typeof(v_notes) = 'object' AND v_notes ? 'notes' AND jsonb_typeof(v_notes->'notes') = 'string' THEN
    BEGIN
      v_notes := (v_notes->>'notes')::jsonb;
    EXCEPTION WHEN OTHERS THEN
      -- ignore
    END;
  END IF;

  -- Handle direct stringified JSON
  IF jsonb_typeof(v_notes) = 'string' THEN
    BEGIN
      v_notes := (v_notes#>>'{}')::jsonb;
    EXCEPTION WHEN OTHERS THEN
      v_notes := '{}'::jsonb;
    END;
  END IF;

  RETURN jsonb_build_object('typeof', jsonb_typeof(v_notes), 'has_materials', v_notes ? 'materials', 'notes', v_notes);
END;
$$;
