-- =============================================================================
-- 20260801000003_039_production_cleanup.sql
-- =============================================================================
-- Purpose: Clean all demo/test data for production deployment
-- 
-- This migration will:
-- 1. Remove all demo customers, suppliers, treasuries, banks
-- 2. Remove all test/demo accounts (keeping standard chart)
-- 3. Clean related transactional data
-- 4. Reset sequences where appropriate
-- 5. Maintain referential integrity
-- 6. Preserve all standard chart of accounts structure
-- 
-- Result: A clean production system ready for a new company
-- =============================================================================

-- =============================================================================
-- SAFETY CHECKS
-- =============================================================================
DO $$
DECLARE
    v_table_exists BOOLEAN;
BEGIN
    -- Verify this is a new migration (should not run on production data)
    -- Check if there's any real business data
    SELECT EXISTS (
        SELECT 1 FROM journal_entries LIMIT 1
    ) INTO v_table_exists;
    
    IF v_table_exists THEN
        RAISE NOTICE 'WARNING: Found journal entries in database.';
        RAISE NOTICE 'This script is designed for demo cleanup.';
        RAISE NOTICE 'Proceeding with cleanup...';
    END IF;
END $$;

-- =============================================================================
-- PHASE 1: AUDIT CURRENT STATE
-- =============================================================================
DO $$
DECLARE
    v_customers_count INT;
    v_suppliers_count INT;
    v_treasuries_count INT;
    v_banks_count INT;
    v_accounts_count INT;
    v_journal_entries_count INT;
    v_ledger_entries_count INT;
BEGIN
    RAISE NOTICE '=== PRE-CLEANUP AUDIT ===';
    
    SELECT COUNT(*) INTO v_customers_count FROM customers;
    SELECT COUNT(*) INTO v_suppliers_count FROM suppliers;
    SELECT COUNT(*) INTO v_treasuries_count FROM treasuries;
    SELECT COUNT(*) INTO v_banks_count FROM bank_accounts;
    SELECT COUNT(*) INTO v_accounts_count FROM accounts;
    SELECT COUNT(*) INTO v_journal_entries_count FROM journal_entries;
    SELECT COUNT(*) INTO v_ledger_entries_count FROM account_ledger_entries;
    
    RAISE NOTICE 'Customers: %', v_customers_count;
    RAISE NOTICE 'Suppliers: %', v_suppliers_count;
    RAISE NOTICE 'Treasuries: %', v_treasuries_count;
    RAISE NOTICE 'Bank Accounts: %', v_banks_count;
    RAISE NOTICE 'Total Accounts: %', v_accounts_count;
    RAISE NOTICE 'Journal Entries: %', v_journal_entries_count;
    RAISE NOTICE 'Ledger Entries: %', v_ledger_entries_count;
    RAISE NOTICE '';
END $$;

-- =============================================================================
-- PHASE 2: CLEAN DEMO CUSTOMERS
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 2: Clean Demo Customers ===';
    
    -- Delete demo customers (identified by test names)
    DELETE FROM customers
    WHERE name ILIKE '%mahmoud%'
       OR name ILIKE '%mazen%'
       OR name ILIKE '%ali%'
       OR name ILIKE '%mohamed%'
       OR name ILIKE '%test%'
       OR name ILIKE '%demo%'
       OR name ILIKE '%experiment%'
       OR name ILIKE '%new%'
       OR name ILIKE '%sample%';
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo customers deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 3: CLEAN DEMO SUPPLIERS
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 3: Clean Demo Suppliers ===';
    
    -- Delete demo suppliers
    DELETE FROM suppliers
    WHERE name ILIKE '%mahmoud%'
       OR name ILIKE '%mazen%'
       OR name ILIKE '%ali%'
       OR name ILIKE '%mohamed%'
       OR name ILIKE '%test%'
       OR name ILIKE '%demo%'
       OR name ILIKE '%experiment%'
       OR name ILIKE '%new%'
       OR name ILIKE '%sample%';
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo suppliers deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 4: CLEAN DEMO TREASURIES
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 4: Clean Demo Treasuries ===';
    
    -- Delete demo treasuries (keep only main EGP if exists)
    DELETE FROM treasuries
    WHERE name ILIKE '%eur%'
       OR name ILIKE '%gbp%'
       OR name ILIKE '%usd%'
       OR name ILIKE '%test%'
       OR name ILIKE '%demo%'
       OR name ILIKE '%experiment%'
       OR name ILIKE '%sample%';
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo treasuries deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 5: CLEAN DEMO BANK ACCOUNTS
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 5: Clean Demo Bank Accounts ===';
    
    -- Delete demo bank accounts
    DELETE FROM bank_accounts
    WHERE name ILIKE '%test%'
       OR name ILIKE '%demo%'
       OR name ILIKE '%experiment%'
       OR name ILIKE '%sample%'
       OR name_en ILIKE '%test%'
       OR name_en ILIKE '%demo%';
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo bank accounts deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 6: CLEAN DEMO ACCOUNTS (11xxx and 20xxx test accounts)
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
    v_demo_account_ids TEXT[];
BEGIN
    RAISE NOTICE '=== PHASE 6: Clean Demo Accounts ===';
    
    -- First, collect demo customer account IDs (11xxx with test names)
    SELECT ARRAY_AGG(id::TEXT) INTO v_demo_account_ids
    FROM accounts
    WHERE account_code LIKE '11%'
      AND (
          account_name ILIKE '%mahmoud%'
          OR account_name ILIKE '%mazen%'
          OR account_name ILIKE '%ali%'
          OR account_name ILIKE '%mohamed%'
          OR account_name ILIKE '%test%'
          OR account_name ILIKE '%demo%'
          OR account_name ILIKE '%experiment%'
          OR account_name ILIKE '%new%'
          OR account_name ILIKE '%sample%'
      );
    
    -- Delete from posting_profile_rules first (if any references exist)
    IF v_demo_account_ids IS NOT NULL AND array_length(v_demo_account_ids, 1) > 0 THEN
        DELETE FROM posting_profile_rules
        WHERE account_id::TEXT = ANY(v_demo_account_ids);
        
        GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
        RAISE NOTICE 'Posting profile rules deleted for demo customer accounts: %', v_deleted_count;
    END IF;
    
    -- Delete demo customer accounts
    DELETE FROM accounts
    WHERE account_code LIKE '11%'
      AND (
          account_name ILIKE '%mahmoud%'
          OR account_name ILIKE '%mazen%'
          OR account_name ILIKE '%ali%'
          OR account_name ILIKE '%mohamed%'
          OR account_name ILIKE '%test%'
          OR account_name ILIKE '%demo%'
          OR account_name ILIKE '%experiment%'
          OR account_name ILIKE '%new%'
          OR account_name ILIKE '%sample%'
      );
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo customer accounts deleted: %', v_deleted_count;
    
    -- Reset for supplier accounts
    v_demo_account_ids := '{}';
    
    -- Collect demo supplier account IDs (20xxx with test names)
    SELECT ARRAY_AGG(id::TEXT) INTO v_demo_account_ids
    FROM accounts
    WHERE account_code LIKE '20%'
      AND (
          account_name ILIKE '%mahmoud%'
          OR account_name ILIKE '%mazen%'
          OR account_name ILIKE '%ali%'
          OR account_name ILIKE '%mohamed%'
          OR account_name ILIKE '%test%'
          OR account_name ILIKE '%demo%'
          OR account_name ILIKE '%experiment%'
          OR account_name ILIKE '%new%'
          OR account_name ILIKE '%sample%'
      );
    
    -- Delete from posting_profile_rules first (if any references exist)
    IF v_demo_account_ids IS NOT NULL AND array_length(v_demo_account_ids, 1) > 0 THEN
        DELETE FROM posting_profile_rules
        WHERE account_id::TEXT = ANY(v_demo_account_ids);
        
        GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
        RAISE NOTICE 'Posting profile rules deleted for demo supplier accounts: %', v_deleted_count;
    END IF;
    
    -- Delete demo supplier accounts
    DELETE FROM accounts
    WHERE account_code LIKE '20%'
      AND (
          account_name ILIKE '%mahmoud%'
          OR account_name ILIKE '%mazen%'
          OR account_name ILIKE '%ali%'
          OR account_name ILIKE '%mohamed%'
          OR account_name ILIKE '%test%'
          OR account_name ILIKE '%demo%'
          OR account_name ILIKE '%experiment%'
          OR account_name ILIKE '%new%'
          OR account_name ILIKE '%sample%'
      );
    
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Demo supplier accounts deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 7: CLEAN TRANSACTIONAL DATA
-- =============================================================================
DO $$
DECLARE
    v_deleted_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 7: Clean Transactional Data ===';
    
    -- Clean financial audit logs
    DELETE FROM financial_audit_log;
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Financial audit logs deleted: %', v_deleted_count;
    
    -- Clean audit logs
    DELETE FROM audit_logs;
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Audit logs deleted: %', v_deleted_count;
    
    -- Clean statement notes
    DELETE FROM statement_notes;
    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;
    RAISE NOTICE 'Statement notes deleted: %', v_deleted_count;
END $$;

-- =============================================================================
-- PHASE 8: FIX ORPHAN ACCOUNTS
-- =============================================================================
DO $$
DECLARE
    v_fixed_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 8: Fix Orphan Accounts ===';
    
    -- Set parent_id to NULL for accounts with non-existent parents
    UPDATE accounts
    SET parent_id = NULL
    WHERE parent_id IS NOT NULL
      AND parent_id::TEXT != ''
      AND NOT EXISTS (
          SELECT 1 FROM accounts p WHERE p.id::TEXT = accounts.parent_id::TEXT
      );
    
    GET DIAGNOSTICS v_fixed_count = ROW_COUNT;
    RAISE NOTICE 'Orphan accounts fixed: %', v_fixed_count;
END $$;

-- =============================================================================
-- PHASE 9: RESET BALANCE CACHES
-- =============================================================================
DO $$
DECLARE
    v_reset_count INT;
BEGIN
    RAISE NOTICE '=== PHASE 9: Reset Balance Caches ===';
    
    -- Reset customer balances to initial_balance
    UPDATE customers
    SET balance = COALESCE(initial_balance, 0);
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Customer balances reset: %', v_reset_count;
    
    -- Reset supplier balances to initial_balance
    UPDATE suppliers
    SET outstanding_balance = COALESCE(initial_balance, 0);
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Supplier balances reset: %', v_reset_count;
    
    -- Reset treasury balances to 0
    UPDATE treasury_balances
    SET balance = 0;
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Treasury balances reset: %', v_reset_count;
    
    -- Reset bank account balances to 0
    UPDATE bank_accounts
    SET balance = 0;
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Bank account balances reset: %', v_reset_count;
    
    -- Reset clearing agent balances
    UPDATE clearing_agents
    SET balance = COALESCE(initial_balance, 0);
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Clearing agent balances reset: %', v_reset_count;
    
    -- Reset shipping company balances
    UPDATE shipping_companies
    SET balance = COALESCE(initial_balance, 0);
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Shipping company balances reset: %', v_reset_count;
    
    -- Reset shareholder balances
    UPDATE shareholders
    SET current_balance_egp = COALESCE(initial_balance_egp, 0),
        current_balance_usd = COALESCE(initial_balance_usd, 0),
        current_balance_eur = COALESCE(initial_balance_eur, 0),
        current_balance_gbp = COALESCE(initial_balance_gbp, 0);
    GET DIAGNOSTICS v_reset_count = ROW_COUNT;
    RAISE NOTICE 'Shareholder balances reset: %', v_reset_count;
END $$;

-- =============================================================================
-- PHASE 10: VERIFY STANDARD CHART PRESERVATION
-- =============================================================================
DO $$
DECLARE
    v_root_accounts INT;
    v_standard_accounts INT;
    v_orphan_accounts INT;
    v_duplicate_codes INT;
BEGIN
    RAISE NOTICE '=== PHASE 10: Verify Standard Chart Preservation ===';
    
    -- Count root accounts (should be 5: Assets, Liabilities, Equity, Revenue, Expenses)
    SELECT COUNT(*) INTO v_root_accounts
    FROM accounts
    WHERE parent_id IS NULL OR parent_id::TEXT = '';
    RAISE NOTICE 'Root accounts: %', v_root_accounts;
    
    -- Count standard accounts (main chart structure)
    SELECT COUNT(*) INTO v_standard_accounts
    FROM accounts
    WHERE account_code ~ '^[1-5][0-9]{3}$' OR account_code ~ '^[1-5]$';
    RAISE NOTICE 'Standard main accounts: %', v_standard_accounts;
    
    -- Check for orphan accounts
    SELECT COUNT(*) INTO v_orphan_accounts
    FROM accounts a
    WHERE a.parent_id IS NOT NULL
      AND a.parent_id::TEXT != ''
      AND NOT EXISTS (
          SELECT 1 FROM accounts p WHERE p.id::TEXT = a.parent_id::TEXT
      );
    RAISE NOTICE 'Orphan accounts: %', v_orphan_accounts;
    
    -- Check for duplicate codes
    SELECT COUNT(*) INTO v_duplicate_codes
    FROM (
        SELECT account_code, COUNT(*) as count
        FROM accounts
        GROUP BY account_code
        HAVING COUNT(*) > 1
    ) AS dup;
    RAISE NOTICE 'Duplicate codes: %', v_duplicate_codes;
END $$;

-- =============================================================================
-- PHASE 11: POST-CLEANUP AUDIT
-- =============================================================================
DO $$
DECLARE
    v_customers_count INT;
    v_suppliers_count INT;
    v_treasuries_count INT;
    v_banks_count INT;
    v_accounts_count INT;
    v_journal_entries_count INT;
    v_ledger_entries_count INT;
BEGIN
    RAISE NOTICE '';
    RAISE NOTICE '=== POST-CLEANUP AUDIT ===';
    
    SELECT COUNT(*) INTO v_customers_count FROM customers;
    SELECT COUNT(*) INTO v_suppliers_count FROM suppliers;
    SELECT COUNT(*) INTO v_treasuries_count FROM treasuries;
    SELECT COUNT(*) INTO v_banks_count FROM bank_accounts;
    SELECT COUNT(*) INTO v_accounts_count FROM accounts;
    SELECT COUNT(*) INTO v_journal_entries_count FROM journal_entries;
    SELECT COUNT(*) INTO v_ledger_entries_count FROM account_ledger_entries;
    
    RAISE NOTICE 'Customers: %', v_customers_count;
    RAISE NOTICE 'Suppliers: %', v_suppliers_count;
    RAISE NOTICE 'Treasuries: %', v_treasuries_count;
    RAISE NOTICE 'Bank Accounts: %', v_banks_count;
    RAISE NOTICE 'Total Accounts: %', v_accounts_count;
    RAISE NOTICE 'Journal Entries: %', v_journal_entries_count;
    RAISE NOTICE 'Ledger Entries: %', v_ledger_entries_count;
    RAISE NOTICE '';
END $$;

-- =============================================================================
-- PRODUCTION READINESS CHECK
-- =============================================================================
DO $$
DECLARE
    v_orphan_accounts INT;
    v_duplicate_codes INT;
    v_is_ready BOOLEAN := TRUE;
BEGIN
    RAISE NOTICE '=== PRODUCTION READINESS CHECK ===';
    
    -- Check for orphan accounts
    SELECT COUNT(*) INTO v_orphan_accounts
    FROM accounts a
    WHERE a.parent_id IS NOT NULL
      AND a.parent_id::TEXT != ''
      AND NOT EXISTS (
          SELECT 1 FROM accounts p WHERE p.id::TEXT = a.parent_id::TEXT
      );
    
    IF v_orphan_accounts > 0 THEN
        RAISE NOTICE '✗ FAIL: Found % orphan accounts', v_orphan_accounts;
        v_is_ready := FALSE;
    ELSE
        RAISE NOTICE '✓ PASS: No orphan accounts';
    END IF;
    
    -- Check for duplicate codes
    SELECT COUNT(*) INTO v_duplicate_codes
    FROM (
        SELECT account_code, COUNT(*) as count
        FROM accounts
        GROUP BY account_code
        HAVING COUNT(*) > 1
    ) AS dup;
    
    IF v_duplicate_codes > 0 THEN
        RAISE NOTICE '✗ FAIL: Found % duplicate codes', v_duplicate_codes;
        v_is_ready := FALSE;
    ELSE
        RAISE NOTICE '✓ PASS: No duplicate codes';
    END IF;
    
    -- Final verdict
    RAISE NOTICE '';
    IF v_is_ready THEN
        RAISE NOTICE '╔══════════════════════════════════════════════════════════╗';
        RAISE NOTICE '║  PRODUCTION READY                                        ║';
        RAISE NOTICE '║  System is clean and ready for a new company              ║';
        RAISE NOTICE '╚══════════════════════════════════════════════════════════╝';
    ELSE
        RAISE NOTICE '╔══════════════════════════════════════════════════════════╗';
        RAISE NOTICE '║  NOT PRODUCTION READY                                     ║';
        RAISE NOTICE '║  Please fix the issues above before deployment            ║';
        RAISE NOTICE '╚══════════════════════════════════════════════════════════╝';
    END IF;
END $$;
